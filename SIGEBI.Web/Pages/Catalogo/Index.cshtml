@page
@model SIGEBI.Web.Pages.Catalogo.IndexModel
@{
    ViewData["Title"] = "Catálogo";
}

<h2>Catálogo</h2>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <p style="color:red;">@Model.Error</p>
}
else if (Model.Rows.Count == 0)
{
    <p>No hay elementos en el catálogo.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Título</th>
                <th>Autor</th>
                <th>ISBN</th>
                <th>Copias Disponibles</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@SIGEBI.Web.Pages.Catalogo.IndexModel.Get(row, "id", "Id")</td>
                    <td>@SIGEBI.Web.Pages.Catalogo.IndexModel.Get(row, "titulo", "Titulo")</td>
                    <td>@SIGEBI.Web.Pages.Catalogo.IndexModel.Get(row, "autor", "Autor")</td>
                    <td>@SIGEBI.Web.Pages.Catalogo.IndexModel.Get(row, "isbn", "ISBN")</td>
                    <td>@SIGEBI.Web.Pages.Catalogo.IndexModel.Get(row, "copiasDisponibles", "CopiasDisponibles")</td>
                </tr>
            }
        </tbody>
    </table>
}